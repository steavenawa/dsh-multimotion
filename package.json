{
  "name": "dsh-multimotion",
  "version": "0.2.0",
  "description": "动效与主视口性能增强 (Multimotion) for DeepSeek Harness: message entrances, streaming shimmer, expand/collapse, directional motion blur, offscreen weak-loading with incremental resize reflow — plus a viewport subpackage.",
  "type": "module",
  "license": "MIT",
  "author": "Steven Jiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steavenawa/dsh-multimotion.git"
  },
  "homepage": "https://github.com/steavenawa/dsh-multimotion#readme",
  "bugs": {
    "url": "https://github.com/steavenawa/dsh-multimotion/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "animation",
    "motion",
    "motion-blur",
    "viewport",
    "performance",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./viewport": "./viewport/index.js",
    "./viewport/locale/*.json": "./viewport/locale/*.json",
    "./viewport/icon": "./viewport/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "viewport/index.js",
    "viewport/locale/*.json",
    "viewport/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}


